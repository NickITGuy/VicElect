{
  "name": "vicelect",
  "version": "0.1.0",
  "description": "Victorian state election results",
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --env-file-if-exists=.env --watch server/index.ts",
    "dev:web": "vite",
    "typecheck": "tsc --noEmit",
    "test": "node --test server/vec.test.ts",
    "build": "npm run typecheck && vite build",
    "start": "node --env-file-if-exists=.env server/index.ts"
  },
  "type": "module",
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "express": "^5.3.0",
    "fast-xml-parser": "^5.12.1",
    "fflate": "^0.8.3",
    "lucide-react": "^1.77.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "engines": {
    "node": ">=24"
  },
  "private": true
}
